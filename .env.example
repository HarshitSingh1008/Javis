# NEXUS AI v4.0 - Environment Variables (Local-First / Ollama Primary)
# Copy this to ~/.nexus_ai/.env and customize

# ── LLM Primary: Ollama (Local, Free, Unlimited) ──────────────────────────────
# Install: curl -fsSL https://ollama.ai/install.sh | sh
# Then: ollama pull llama3.2:3b-instruct-q4_K_M
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b-instruct-q4_K_M
OLLAMA_INTENT_MODEL=tinyllama:1.1b-chat-v1-q4_K_M

# ── LLM Fallback: Groq (Cloud, Rate-Limited, Optional) ────────────────────────
# Get free key at: https://console.groq.com
# Only needed if you want cloud fallback when Ollama is unavailable
# GROQ_API_KEY=gsk_your_key_here

# ── LLM Fallback: OpenAI (Cloud, Paid, Optional) ──────────────────────────────
# Get key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk_your_key_here

# ── Audio / Voice ──────────────────────────────────────────────────────────────
# Porcupine wake word (optional): https://console.picovoice.ai
# PORCUPINE_ACCESS_KEY=your_key_here
WAKE_WORDS=nexus,jarvis

# ── UI / Window ────────────────────────────────────────────────────────────────
UI_THEME=dark_platinum
WINDOW_WIDTH=1400
WINDOW_HEIGHT=900

# ── Performance (tune for your hardware) ───────────────────────────────────────
PARALLEL_TOOL_WORKERS=3
UI_PARTICLE_COUNT=60
UI_ANIMATION_FPS=60

# ── Unlimited Tokens (Groq Cloud) ──────────────────────────────────────────────
# Set these to maximum for unlimited-like token generation with Groq API
# Get free key at: https://console.groq.com
GROQ_API_KEY=gsk_your_key_here
LLM_MAX_TOKENS=32768
LLM_REQUEST_TIMEOUT=300
GROQ_REQUESTS_PER_MINUTE=1000
CIRCUIT_BREAKER_FAILURES=10
AGENT_MAX_ITERATIONS=50
AGENT_MAX_RETRIES=10

# ── Sandbox ────────────────────────────────────────────────────────────────────
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MAX_MEMORY_MB=512